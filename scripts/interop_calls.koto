export bench_call_empty = ||
    sum = 0
    for _ in 0..100_000
        sum += interop_ping()
    sum

export bench_call_one_i64 = ||
    sum = 0
    for _ in 0..100_000
        sum += interop_id_i64 7
    sum

export bench_call_three_i64 = ||
    sum = 0
    for _ in 0..100_000
        sum += interop_sum_i64_3 1, 2, 3
    sum

export bench_call_five_i64 = ||
    sum = 0
    for _ in 0..100_000
        sum += interop_sum_i64_5 1, 2, 3, 4, 5
    sum

export bench_call_f64 = ||
    sum = 0
    for _ in 0..100_000
        sum += interop_id_f64 1.5
    sum

export bench_call_string_in = ||
    sum = 0
    for _ in 0..100_000
        sum += interop_strlen 'interop'
    sum

export bench_call_string_out = ||
    sum = 0
    for _ in 0..100_000
        sum += size interop_string_out()
    sum
