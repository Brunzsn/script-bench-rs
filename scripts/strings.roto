const COUNT: u64 = 5000;

fn bench() -> u64 {
    let parts: List[String] = [];
    let index: u64 = 0;
    while index < COUNT {
        parts.push(f"item-{index}");
        index = index + 1;
    }

    let joined = parts.join(",");
    let split_parts = joined.split(",");
    let pipe_joined = split_parts.join("|");
    let replaced = pipe_joined.replace("item-", "row-");
    let marked = replaced.replace("row-4999", "last");
    let unicode_text = "héllo—世界🚀";
    let unicode_length = unicode_text.chars().len();

    let checksum = joined.chars().len() + pipe_joined.chars().len() + marked.chars().len() + split_parts.len() + unicode_length;
    if marked.contains("last") {
        checksum + 1
    } else {
        checksum
    }
}
