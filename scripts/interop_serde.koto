export bench_serde_to_script = |value|
    value.id
        + size value.name
        + value.values[0]
        + value.values[1]
        + value.values[2]
        + value.child.id

export bench_serde_from_script = ||
    {
        id: 7,
        name: 'interop',
        values: [1.0, 2.0, 3.0],
        child: { id: 9 },
    }
