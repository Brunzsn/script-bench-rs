export bench = ||
    count = 100_000
    modulus = 1_000_000_007

    values = []
    for index in 0..count
        values.push index

    indexed_sum = 0
    for index in 0..count
        indexed_sum += values[index]

    iterated_sum = 0
    for value in values
        iterated_sum += value

    (indexed_sum + iterated_sum) % modulus
