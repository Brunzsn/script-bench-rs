n = 300
iterations = 10

eval_a = |i, j|
    i_float = i * 1.0
    j_float = j * 1.0
    1.0 / ((i_float + j_float) * (i_float + j_float + 1.0) / 2.0 + i_float + 1.0)

export bench = ||
    u = []
    v = []
    for _ in 0..n
        u.push 1.0
        v.push 0.0

    for _ in 0..iterations
        for i in 0..n
            sum = 0.0
            for j in 0..n
                sum += (eval_a i, j) * u[j]
            v[i] = sum

        for i in 0..n
            u[i] = 0.0
        for i in 0..n
            value = v[i]
            for j in 0..n
                u[j] += (eval_a i, j) * value

    for i in 0..n
        sum = 0.0
        for j in 0..n
            sum += (eval_a i, j) * u[j]
        v[i] = sum

    v_bv = 0.0
    vv = 0.0
    for i in 0..n
        v_bv += u[i] * v[i]
        vv += v[i] * v[i]

    (v_bv / vv).sqrt()
